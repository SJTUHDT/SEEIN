<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- dsh-pet 0.4.9 shared/menu/css.ts: original fixed light palette and exact CSS pixel metrics. -->
    <SolidColorBrush x:Key="PetMenuPanelBrush" Color="#FAFFFFFF" />
    <SolidColorBrush x:Key="PetMenuBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="PetMenuTextBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PetMenuHintBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="PetMenuHoverBrush" Color="#242B63FF" />
    <DataTemplate x:Key="PetMenuLabel">
        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" LineHeight="19.5" LineStackingStrategy="BlockLineHeight"
                   VerticalAlignment="Center" />
    </DataTemplate>
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PetMenuTextBrush}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="28,20,28,36">
                        <Border x:Name="MenuPanel" Background="{StaticResource PetMenuPanelBrush}" BorderBrush="{StaticResource PetMenuBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="150" MaxWidth="300" SnapsToDevicePixels="True">
                            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.2" Color="Black" /></Border.Effect>
                            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" MaxHeight="450">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource PetMenuTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HeaderTemplate" Value="{StaticResource PetMenuLabel}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid x:Name="Row" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon" Content="{TemplateBinding Icon}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                            <TextBlock x:Name="Hint" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource PetMenuHintBrush}"
                                       FontSize="12" Margin="14,0,0,0" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="▸" FontSize="12" Foreground="{StaticResource PetMenuHintBrush}"
                                       Margin="14,0,0,0" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                                   PlacementTarget="{Binding ElementName=ItemBorder}" HorizontalOffset="-19" VerticalOffset="-20"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Grid Margin="28,20,28,36">
                                    <Border x:Name="SubmenuPanel" Background="{StaticResource PetMenuPanelBrush}" BorderBrush="{StaticResource PetMenuBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="150" MaxWidth="300">
                                        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.2" Color="Black" /></Border.Effect>
                                        <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" MaxHeight="450">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="InputGestureText" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PetMenuHoverBrush}" /></Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PetMenuHoverBrush}" /></Trigger>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Margin" Value="12,5" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource PetMenuBorderBrush}" /></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
