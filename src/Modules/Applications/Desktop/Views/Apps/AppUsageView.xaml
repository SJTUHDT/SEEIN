<UserControl x:Class="Seein.Tray.AppUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Seein.Tray" xmlns:shared="clr-namespace:Seein.Tray;assembly=Seein.Desktop.Shared"
             Background="Transparent" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border Style="{StaticResource SegmentedHostStyle}" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DayModeButton" Content="日" Style="{StaticResource SegmentedButtonStyle}"
                                     IsChecked="True" Checked="Mode_Changed" />
                        <RadioButton x:Name="WeekModeButton" Content="周" Style="{StaticResource SegmentedButtonStyle}"
                                     Checked="Mode_Changed" />
                    </StackPanel>
                </Border>
                <Button x:Name="PreviousButton" AutomationProperties.Name="上一时段" Width="34" Click="Previous_Click" Margin="0,0,4,0"
                        Content="&#xE76B;" FontFamily="{DynamicResource IconFontFamily}" FontSize="{DynamicResource TypeCaptionSize}" Padding="0" />
                <TextBlock x:Name="DateText" VerticalAlignment="Center" FontSize="13" MinWidth="100"
                           TextAlignment="Center" />
                <Button x:Name="NextButton" AutomationProperties.Name="下一时段" Width="34" Click="Next_Click" Margin="4,0,14,0"
                        Content="&#xE76C;" FontFamily="{DynamicResource IconFontFamily}" FontSize="{DynamicResource TypeCaptionSize}" Padding="0" />
                <Button Content="生成摘要" Click="Summary_Click" Margin="0,0,8,0" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="Card1Caption" Style="{StaticResource CardCaptionStyle}" Text="应用运行时长合计" />
                    <TextBlock x:Name="Card1Value" Style="{StaticResource CardValueStyle}" Text="—" Margin="0,6,0,0" FontSize="22" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="Card2Caption" Style="{StaticResource CardCaptionStyle}" Text="打开应用个数" />
                    <TextBlock x:Name="Card2Value" Style="{StaticResource CardValueStyle}" Text="—" Margin="0,6,0,0" FontSize="22" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="Card3Caption" Style="{StaticResource CardCaptionStyle}" Text="系统已运行" />
                    <TextBlock x:Name="Card3Value" Style="{StaticResource CardValueStyle}" Text="—" Margin="0,6,0,0" FontSize="22" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="Card4Caption" Style="{StaticResource CardCaptionStyle}" Text="活跃时长" />
                    <TextBlock x:Name="Card4Value" Style="{StaticResource CardValueStyle}" Text="—" Margin="0,6,0,0" FontSize="22" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" MinHeight="250" Padding="10,12" Margin="0,0,0,16">
                <Grid>
                    <local:GanttChart x:Name="Gantt" AutomationProperties.Name="应用运行时间轴" />
                    <shared:WeekBars x:Name="WeekChart" AutomationProperties.Name="七天趋势图" Visibility="Collapsed" />
                    <TextBlock x:Name="ChartEmpty" Text="今天还没有采集到数据" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="6,0,6,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="应用排行" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HiddenHint" FontSize="{DynamicResource TypeCaptionSize}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleTextBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="SortSelector" AutomationProperties.Name="应用时长排序" Grid.Column="1" Width="120" Margin="0,0,16,0"
                                  Style="{StaticResource SidebarThemeSelectorStyle}" SelectionChanged="Sort_Changed">
                            <ComboBoxItem Content="按时长排序" Tag="duration" />
                            <ComboBoxItem Content="按耗电排序" Tag="power" />
                        </ComboBox>
                        <CheckBox x:Name="ShowAllToggle" Grid.Column="2" Content="显示全部应用"
                                  VerticalAlignment="Center" Checked="ShowAll_Changed" Unchecked="ShowAll_Changed" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="232">
                        <ItemsControl x:Name="AppList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="46" Margin="6,0,6,0" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ProgressBar Value="{Binding SharePercent}" Maximum="100" Margin="0,7,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                    Margin="0,0,14,0">
                                            <TextBlock Text="{Binding DurationText}" FontSize="13" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ActiveText}" FontSize="{DynamicResource TypeCaptionSize}" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding PowerText}" FontSize="13"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
