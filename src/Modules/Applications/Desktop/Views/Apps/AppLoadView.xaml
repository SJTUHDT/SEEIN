<UserControl x:Class="Seein.Tray.AppLoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="LoadHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoadRowGridStyle" TargetType="Grid">
            <Setter Property="Height" Value="34" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviousButton" AutomationProperties.Name="上一时段" Width="30" Click="Previous_Click" Margin="0,0,6,0"
                        Content="&#xE76B;" FontFamily="{DynamicResource IconFontFamily}" FontSize="{DynamicResource TypeCaptionSize}" Padding="0" />
                <TextBlock x:Name="DateText" VerticalAlignment="Center" FontSize="12.5" MinWidth="96"
                           TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                <Button x:Name="NextButton" AutomationProperties.Name="下一时段" Width="30" Click="Next_Click" Margin="6,0,0,0"
                        Content="&#xE76C;" FontFamily="{DynamicResource IconFontFamily}" FontSize="{DynamicResource TypeCaptionSize}" Padding="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CPU (top left) -->
            <Border Style="{StaticResource CardStyle}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CPU 占用" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Grid.Row="1" Margin="4,0,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CpuNameHeader" Content="名称" Tag="name" HorizontalContentAlignment="Left"
                                Style="{StaticResource LoadHeaderButtonStyle}" Click="CpuSort_Click" />
                        <Button x:Name="CpuTimeHeader" Grid.Column="1" Content="使用时长" Tag="time"
                                HorizontalContentAlignment="Right" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="CpuSort_Click" />
                        <Button x:Name="CpuMinHeader" Grid.Column="2" Content="最低" Tag="min"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="CpuSort_Click" />
                        <Button x:Name="CpuValueHeader" Grid.Column="3" Content="平均" Tag="value"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="CpuSort_Click" />
                        <Button x:Name="CpuPeakHeader" Grid.Column="4" Content="最高" Tag="peak"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="CpuSort_Click" />
                        <Button x:Name="CpuShareHeader" Grid.Column="5" Content="占比" Tag="share"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="CpuSort_Click" />
                        <Border Grid.ColumnSpan="6" Height="1" Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Bottom" Margin="0,0,0,-3" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CpuList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource LoadRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" />
                                            <TextBlock Text="{Binding Name}" Margin="6,0,4,0" FontSize="12"
                                                       FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MinText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ValueText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   FontWeight="{Binding ValueWeight}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding PeakText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="5" Text="{Binding ShareText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Network (right column, full height) -->
            <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource CardStyle}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="网络使用" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Grid.Row="1" Margin="4,0,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NetNameHeader" Content="名称" Tag="name" HorizontalContentAlignment="Left"
                                Style="{StaticResource LoadHeaderButtonStyle}" Click="NetSort_Click" />
                        <Button x:Name="NetUpHeader" Grid.Column="1" Content="上传" Tag="up"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="NetSort_Click" />
                        <Button x:Name="NetDownHeader" Grid.Column="2" Content="下载" Tag="down"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="NetSort_Click" />
                        <Button x:Name="NetTotalHeader" Grid.Column="3" Content="合计" Tag="total"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="NetSort_Click" />
                        <Border Grid.ColumnSpan="4" Height="1" Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Bottom" Margin="0,0,0,-3" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource LoadRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" />
                                            <TextBlock Text="{Binding Name}" Margin="6,0,4,0" FontSize="12"
                                                       FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value2Text}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Value3Text}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   FontWeight="{Binding ValueWeight}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- GPU (bottom left) -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="GPU 占用" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Grid.Row="1" Margin="4,0,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="GpuNameHeader" Content="名称" Tag="name" HorizontalContentAlignment="Left"
                                Style="{StaticResource LoadHeaderButtonStyle}" Click="GpuSort_Click" />
                        <Button x:Name="GpuTimeHeader" Grid.Column="1" Content="使用时长" Tag="time"
                                HorizontalContentAlignment="Right" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="GpuSort_Click" />
                        <Button x:Name="GpuMinHeader" Grid.Column="2" Content="最低" Tag="min"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="GpuSort_Click" />
                        <Button x:Name="GpuValueHeader" Grid.Column="3" Content="平均" Tag="value"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="GpuSort_Click" />
                        <Button x:Name="GpuPeakHeader" Grid.Column="4" Content="最高" Tag="peak"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="GpuSort_Click" />
                        <Button x:Name="GpuShareHeader" Grid.Column="5" Content="占比" Tag="share"
                                HorizontalContentAlignment="Center" Style="{StaticResource LoadHeaderButtonStyle}"
                                Click="GpuSort_Click" />
                        <Border Grid.ColumnSpan="6" Height="1" Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Bottom" Margin="0,0,0,-3" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GpuList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource LoadRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" />
                                            <TextBlock Text="{Binding Name}" Margin="6,0,4,0" FontSize="12"
                                                       FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MinText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ValueText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   FontWeight="{Binding ValueWeight}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding PeakText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="5" Text="{Binding ShareText}" FontSize="{DynamicResource TypeCaptionSize}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
