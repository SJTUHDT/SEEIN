<UserControl x:Class="Seein.Tray.PetControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel x:Name="Commands">
                    <Button x:Name="StartButton" Content="启动桌宠" Style="{StaticResource AccentButtonStyle}"
                            Click="Start_Click" Margin="0,0,7,5"/>
                    <Button x:Name="VisibilityButton" Content="隐藏" Click="Visibility_Click" Margin="0,0,7,5"/>
                    <Button x:Name="HomeButton" Content="回到初始位置" Click="Home_Click" Margin="0,0,7,5"/>
                    <Button x:Name="ReloadButton" Content="重载设置" Click="Reload_Click" Margin="0,0,7,5"/>
                    <Button x:Name="StopButton" Content="停止桌宠" Click="Stop_Click" Margin="0,0,7,5"/>
                </WrapPanel>
                <TextBlock x:Name="StateText" Style="{StaticResource CardCaptionStyle}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="BrowserHost" />
    </Grid>
</UserControl>
