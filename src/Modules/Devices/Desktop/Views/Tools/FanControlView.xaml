<UserControl x:Class="Seein.Tray.FanControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:local="clr-namespace:Seein.Tray" xmlns:shared="clr-namespace:Seein.Tray;assembly=Seein.Desktop.Shared"
             Foreground="{DynamicResource TextBrush}" SizeChanged="OnViewSizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <WrapPanel>
                <Button x:Name="BackButton" Content="← 运行总览" Visibility="Collapsed" Click="Back_Click" Margin="0,0,8,6" />
                <Button x:Name="RestoreButton" Content="交还硬件控制" Click="Restore_Click" Margin="0,0,8,6" />
                <Button Content="刷新状态" Click="Refresh_Click" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Style="{StaticResource CardCaptionStyle}" Margin="0,3,0,0" />
        </StackPanel>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,8">
            <Grid>
                <StackPanel x:Name="OverviewPanel">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="主板风扇策略" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <CheckBox x:Name="EnableToggle" Content="请求 SEEIN 接管" VerticalAlignment="Center"
                                          Checked="BoardOption_Changed" Unchecked="BoardOption_Changed" Margin="0,0,14,6" />
                                <ComboBox x:Name="ProfileSelector" MinWidth="108" AutomationProperties.Name="主板风扇配置档"
                                          SelectionChanged="Profile_Changed" Margin="0,0,8,6" />
                                <Button x:Name="ApplyBoardButton" Content="应用主板设置" Style="{StaticResource AccentButtonStyle}"
                                        Click="ApplyBoard_Click" Margin="0,0,8,6" />
                                <Button x:Name="DiscardBoardButton" Content="放弃草稿" Click="DiscardBoard_Click" Margin="0,0,8,6" />
                            </WrapPanel>
                            <TextBlock x:Name="BoardSummary" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="SummaryCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><primitives:UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=local:FanControlView}}" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Rpm}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding Target}" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Temperature}" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Owner}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap"
                                                   Margin="0,2,0,8" />
                                        <Button Content="{Binding Action}" Tag="{Binding Id}" Click="Open_Click" HorizontalAlignment="Left"
                                                AutomationProperties.Name="{Binding AccessibleAction}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource CardStyle}" Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock Text="控制诊断" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,5" />
                            <TextBlock x:Name="DiagnosticText" TextWrapping="Wrap" Style="{StaticResource CardCaptionStyle}" />
                            <Button x:Name="MsiButton" Click="Msi_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" x:Name="MonitoringPanel" Visibility="Collapsed">
                        <StackPanel>
                        <TextBlock Text="其他监测通道" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,5" />
                        <ItemsControl x:Name="MonitoringRows">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,3,10,3" TextWrapping="Wrap" Style="{StaticResource CardCaptionStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="DetailLive" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <WrapPanel x:Name="BoardOptions">
                                <ComboBox x:Name="ModeSelector" AutomationProperties.Name="控制模式" MinWidth="112"
                                          SelectionChanged="BoardOption_Changed" Margin="0,0,8,6">
                                    <ComboBoxItem Content="BIOS 自动" />
                                    <ComboBoxItem Content="固定转速" />
                                    <ComboBoxItem Content="温度曲线" />
                                </ComboBox>
                                <ComboBox x:Name="SourceSelector" AutomationProperties.Name="通道温度来源" MinWidth="112"
                                          SelectionChanged="BoardOption_Changed" Margin="0,0,8,6" />
                                <StackPanel x:Name="ManualPanel" Orientation="Horizontal" Margin="0,0,8,6">
                                    <TextBlock Text="固定占空比 %" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider x:Name="ManualValue" Width="116" VerticalAlignment="Center" TickFrequency="1"
                                            IsSnapToTickEnabled="True" AutomationProperties.Name="固定占空比（百分比）"
                                            ValueChanged="BoardOption_Changed" />
                                    <TextBlock Text="{Binding Value, ElementName=ManualValue, StringFormat={}{0:0}%}"
                                               Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ComboBox x:Name="BranchSelector" MinWidth="95" AutomationProperties.Name="正在编辑的曲线"
                                          SelectionChanged="Branch_Changed" Margin="0,0,8,6">
                                    <ComboBoxItem Content="CPU 曲线" />
                                    <ComboBoxItem Content="GPU 曲线" />
                                </ComboBox>
                            </WrapPanel>
                            <CheckBox x:Name="DisableZero" Content="应用时关闭 Zero RPM" Margin="0,0,0,10"
                                      Checked="GpuOption_Changed" Unchecked="GpuOption_Changed" />
                            <StackPanel x:Name="ChartPanel">
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="温度与占空比" FontWeight="SemiBold" Margin="0,0,16,0" />
                                    <TextBlock Text="━━ 当前设置    ┈┈ 草稿" Style="{StaticResource CardCaptionStyle}" />
                                </WrapPanel>
                                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="8">
                                    <shared:FanCurveEditor x:Name="CurveEditor" Height="260" CurveChanged="Curve_Changed"
                                                          SelectionChanged="CurveSelection_Changed" EditStarted="CurveEdit_Started"
                                                          AutomationProperties.Name="风扇温度与占空比曲线" />
                                </Border>
                                <TextBlock x:Name="KeyboardHelp" Text="Ctrl + ← / → 选点，方向键微调，Insert 新增，Delete 删除。"
                                           Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                <WrapPanel x:Name="PointsPanel">
                                    <ComboBox x:Name="PointSelector" MinWidth="102" AutomationProperties.Name="编辑曲线点"
                                              SelectionChanged="PointSelector_Changed" Margin="0,0,8,6" />
                                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="0,0,4,6" />
                                    <TextBox x:Name="PointTemperature" Width="74" Style="{StaticResource CompactNumberTextBoxStyle}" AutomationProperties.Name="曲线点温度（摄氏度）"
                                             Margin="0,0,8,6" />
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,4,6" />
                                    <TextBox x:Name="PointDuty" Width="74" Style="{StaticResource CompactNumberTextBoxStyle}" AutomationProperties.Name="曲线点占空比（百分比）"
                                             Margin="0,0,8,6" />
                                    <Button Content="更新点" Click="UpdatePoint_Click" Margin="0,0,8,6" />
                                </WrapPanel>
                            </StackPanel>
                            <WrapPanel Margin="0,7,0,0">
                                <Button x:Name="UndoButton" Content="撤销" Click="Undo_Click" Margin="0,0,8,6" />
                                <Button x:Name="ResetButton" Content="重置草稿" Click="Reset_Click" Margin="0,0,8,6" />
                                <Button x:Name="ApplyDetailButton" Content="应用主板设置" Style="{StaticResource AccentButtonStyle}"
                                        Click="ApplyDetail_Click" Margin="0,0,8,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="模拟" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <TextBlock x:Name="SimName" VerticalAlignment="Center" Margin="0,0,8,6" />
                                <TextBox x:Name="SimPrimary" Width="74" Style="{StaticResource CompactNumberTextBoxStyle}" Text="55" AutomationProperties.Name="模拟主温度（摄氏度）"
                                         Margin="0,0,8,6" />
                                <StackPanel x:Name="SimSecondaryPanel" Orientation="Horizontal" Margin="0,0,8,6">
                                    <TextBlock Text="GPU °C" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="SimSecondary" Width="74" Style="{StaticResource CompactNumberTextBoxStyle}" Text="65" AutomationProperties.Name="模拟 GPU 温度（摄氏度）" />
                                </StackPanel>
                                <Button Content="计算目标" Click="Simulate_Click" Margin="0,0,8,6" />
                            </WrapPanel>
                            <TextBlock x:Name="SimResult" Text="模拟只计算草稿的目标占空比。" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" Style="{StaticResource CardCaptionStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="最近 10 分钟" Style="{StaticResource SectionTitleStyle}" />
                            <shared:FanTrendChart x:Name="TrendChart" Height="246" Margin="0,6,0,0"
                                                 AutomationProperties.Name="最近十分钟温度、目标占空比和转速" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
