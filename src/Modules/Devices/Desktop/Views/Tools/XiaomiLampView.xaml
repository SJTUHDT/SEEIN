<UserControl x:Class="Seein.Tray.XiaomiLampView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button x:Name="AuthorizeButton" Content="扫码连接米家" Click="Authorize_Click" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0"/>
                            <Button x:Name="CancelAuthorizationButton" Content="取消连接" Click="CancelAuthorization_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
                            <Button x:Name="ForgetButton" Content="解除本机授权" Click="Forget_Click" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Text="米家显示器挂灯2" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="设备 IP" Style="{StaticResource CardCaptionStyle}" Margin="0,0,0,5"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="Address" AutomationProperties.Name="挂灯 IP 地址"/>
                        <Button x:Name="SaveAddressButton" Grid.Column="1" Content="保存并连接" Click="SaveAddress_Click" Margin="10,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="StateText" Text="点击“扫码连接米家”，在手机上完成授权。" TextWrapping="Wrap" Style="{StaticResource CardCaptionStyle}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel x:Name="AuthorizationPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Left"><Image x:Name="QrImage" Width="240" Height="240" AutomationProperties.Name="小米账号登录二维码"/></Border>
                        <TextBlock Text="请用米家 App 扫码，并在手机上确认登录。" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel x:Name="SelectionPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <ComboBox x:Name="LampSelection" MinWidth="260" AutomationProperties.Name="选择已授权挂灯"/>
                        <Button Content="连接所选挂灯" Click="SelectLamp_Click" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新状态" Click="Refresh_Click" HorizontalAlignment="Right"/><TextBlock Text="灯光控制" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock x:Name="LampStateText" Text="尚未连接" Margin="0,12,0,14"/>
                    <WrapPanel Margin="0,0,0,18">
                        <Button x:Name="OnButton" Content="开灯" Click="On_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0"/>
                        <Button x:Name="OffButton" Content="关灯" Click="Off_Click"/>
                    </WrapPanel>
                    <StackPanel x:Name="LightControls">
                        <TextBlock x:Name="BrightnessText" Text="亮度" Margin="0,0,0,8"/>
                        <Slider x:Name="Brightness" Minimum="1" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LightValue_Changed" AutomationProperties.Name="挂灯亮度"/>
                        <TextBlock x:Name="TemperatureText" Text="色温" Margin="0,20,0,8"/>
                        <Slider x:Name="Temperature" Minimum="2700" Maximum="6500" Value="4000" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="LightValue_Changed" AutomationProperties.Name="挂灯色温"/>
                        <Button x:Name="ApplyLightButton" Content="应用亮度和色温" Click="ApplyLight_Click" HorizontalAlignment="Left" Margin="0,22,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <Grid x:Name="PresetsLayout" SizeChanged="PresetsLayout_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="PresetEditorColumn" Width="3*"/><ColumnDefinition x:Name="PresetButtonsColumn" Width="2*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="PresetEditor">
                    <TextBlock Text="灯光预设" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                    <TextBlock Text="用上方滑块选择亮度和色温，填写名称后保存。点击预设按钮可直接开灯并应用。" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ComboBox x:Name="PresetSelection" SelectionChanged="Preset_Changed" AutomationProperties.Name="已保存的灯光预设" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="预设名称" Margin="0,0,0,5"/><TextBox x:Name="PresetName" Width="230" MaxLength="40" AutomationProperties.Name="预设名称"/></StackPanel>
                        <StackPanel Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="预设快捷键" Margin="0,0,0,5"/><TextBox x:Name="PresetKey" Width="230" IsReadOnly="True" PreviewKeyDown="Shortcut_KeyDown" AutomationProperties.Name="预设快捷键" ToolTip="点击后按快捷键；Backspace 或 Delete 清除"/></StackPanel>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="保存为新预设" Click="AddPreset_Click" Margin="0,0,8,8"/>
                        <Button x:Name="UpdatePresetButton" Content="更新所选预设" Click="UpdatePreset_Click" Margin="0,0,8,8"/>
                        <Button x:Name="ApplyPresetButton" Content="应用所选预设" Click="ApplyPreset_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8"/>
                        <Button x:Name="DeletePresetButton" Content="删除所选预设" Click="DeletePreset_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Text, ElementName=ShortcutStatus}" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="PresetButtonsPanel" Grid.Column="1" Margin="24,0,0,0">
                        <TextBlock Text="已保存的预设" FontWeight="SemiBold" Margin="0,2,0,12"/>
                        <TextBlock x:Name="NoPresetsText" Text="保存后，预设按钮会显示在这里。" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="PresetButtons" AutomationProperties.Name="快捷应用灯光预设">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Click="QuickPreset_Click" Tag="{Binding Preset}" ToolTip="{Binding Details}" Margin="0,0,8,8" Padding="12,8" MaxWidth="210" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ShortcutText}" FontSize="11" Opacity="0.7" Margin="0,3,0,0"/></StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="快捷键已移至应用设置 → 快捷键管理" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                    <WrapPanel Visibility="Collapsed">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="开灯" Margin="0,0,0,5"/><TextBox x:Name="OnKey" Width="230" IsReadOnly="True" PreviewKeyDown="Shortcut_KeyDown" AutomationProperties.Name="开灯快捷键"/></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="关灯" Margin="0,0,0,5"/><TextBox x:Name="OffKey" Width="230" IsReadOnly="True" PreviewKeyDown="Shortcut_KeyDown" AutomationProperties.Name="关灯快捷键"/></StackPanel>
                    </WrapPanel>
                    <TextBlock Text="可单按 F1–F8、Insert、End、Page Up、Page Down，也可使用 Ctrl / Alt 组合键。Backspace 或 Delete 清除。" Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Visibility="Collapsed" Content="保存开关快捷键" Click="SavePowerKeys_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ShortcutStatus" TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource CardCaptionStyle}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
