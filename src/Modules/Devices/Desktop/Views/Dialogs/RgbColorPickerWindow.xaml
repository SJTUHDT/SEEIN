<Window x:Class="Seein.Tray.RgbColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择灯光颜色" Width="584" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="24,20,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="基本颜色" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <UniformGrid x:Name="BasicColors" Rows="6" Columns="8" AutomationProperties.Name="基本颜色" />
                <TextBlock x:Name="BasicColorHint" Margin="2,8,0,0" Text="已采样色块以机箱实拍为准"
                           FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="自定义颜色" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid x:Name="Spectrum" Height="148" ClipToBounds="True" Cursor="Cross"
                      PreviewMouseLeftButtonDown="SpectrumDown" PreviewMouseLeftButtonUp="SpectrumUp"
                      MouseMove="SpectrumMove" SizeChanged="SpectrumSizeChanged">
                    <Border x:Name="HueSurface" CornerRadius="6" />
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="Black" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="SpectrumMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="#44000000" />
                    </Canvas>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Border Height="7" CornerRadius="4" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0000" Offset="0" />
                                <GradientStop Color="#FFFF00" Offset="0.1667" />
                                <GradientStop Color="#00FF00" Offset="0.3333" />
                                <GradientStop Color="#00FFFF" Offset="0.5" />
                                <GradientStop Color="#0000FF" Offset="0.6667" />
                                <GradientStop Color="#FF00FF" Offset="0.8333" />
                                <GradientStop Color="#FF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Slider x:Name="HueSlider" Maximum="360" SmallChange="1" LargeChange="30"
                            IsMoveToPointEnabled="True" Height="23" ValueChanged="HueChanged"
                            AutomationProperties.Name="色相" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HexValue" MaxLength="7" AutomationProperties.Name="HEX 颜色"
                             Style="{StaticResource HexTextBoxStyle}"
                             TextChanged="HexChanged" VerticalContentAlignment="Center" />
                    <Border x:Name="Preview" Grid.Column="2" Height="32" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" ToolTip="机箱颜色预览" />
                </Grid>
                <TextBlock x:Name="HexHint" Margin="0,6,0,0" FontSize="12" Text="HEX 色号"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" MinWidth="92" IsCancel="True" />
                <Button x:Name="Confirm" Content="确定" MinWidth="92" Margin="8,0,0,0" IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}" Click="ConfirmClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
