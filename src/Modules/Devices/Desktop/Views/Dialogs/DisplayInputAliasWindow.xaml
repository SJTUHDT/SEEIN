<Window x:Class="Seein.Tray.DisplayInputAliasWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="输入源本地昵称" Width="460" SizeToContent="Height" ResizeMode="NoResize"
 ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource TypeBodySize}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="24,20,24,20">
   <TextBlock Text="输入源本地昵称" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock x:Name="PortLabel" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <TextBlock Text="连接的设备名称" Margin="0,0,0,6"/>
   <TextBox x:Name="AliasBox" MaxLength="64" AutomationProperties.Name="输入源昵称"/>
   <TextBlock Text="例如 Switch 2、笔记本。留空保存可恢复端口名称。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <TextBlock x:Name="Feedback" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <Border Grid.Row="1" Padding="24,12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
    <Button Content="保存" IsDefault="True" MinWidth="80" Style="{StaticResource AccentButtonStyle}" Click="SaveClicked"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
