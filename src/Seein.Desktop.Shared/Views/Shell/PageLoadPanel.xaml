<UserControl x:Class="Seein.Tray.PageLoadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBrush}">
        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="420" MinWidth="290" Padding="24" Margin="16">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleStyle}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="DetailText" Style="{StaticResource CardCaptionStyle}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,0"
                             Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="加载进度" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
