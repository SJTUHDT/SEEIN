<UserControl x:Class="Seein.Tray.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="DashboardBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="3.5" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="3.5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="DashValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="DashCell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- KPI row -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="副屏连接" Style="{StaticResource DashLabel}" />
                    <TextBlock x:Name="DeviceText" Text="正在连接后台服务…" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,2" TextWrapping="Wrap" />
                    <TextBlock Text="1920 × 462 · 显示设备状态" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource SubtleTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="整机功率估算" Style="{StaticResource DashLabel}" />
                    <TextBlock x:Name="PowerText" Text="— W" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2" />
                    <TextBlock Text="CPU/GPU 传感器 + 基线 + 电源效率" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Button Click="OpenEnergy_Click" Background="{DynamicResource AccentSoftBrush}" BorderThickness="0"
                    HorizontalContentAlignment="Stretch" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="累计估算耗电" Style="{StaticResource DashLabel}" />
                    <TextBlock x:Name="TotalEnergyText" Text="— kWh" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,2" />
                    <TextBlock Text="查看耗能统计 →" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Button>
            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="历史单日最高耗电" Style="{StaticResource DashLabel}" />
                    <TextBlock x:Name="HighestDayText" Text="— kWh" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2" />
                    <TextBlock x:Name="HighestDayDate" Text="尚无记录" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource SubtleTextBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- CPU / GPU -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" x:Name="CpuLoadText" Text="—" FontSize="25" FontWeight="SemiBold" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="使用率" Style="{StaticResource DashLabel}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Grid.Row="1" x:Name="CpuLoadBar" AutomationProperties.Name="CPU 使用率" Style="{StaticResource DashboardBarStyle}" Margin="0,8,0,0" />
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="温度" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="CpuTempText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="功率" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="CpuPowerText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="频率" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="CpuClockText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="核心电压" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="CpuVoltageText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" x:Name="GpuLoadText" Text="—" FontSize="25" FontWeight="SemiBold" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GPU" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="使用率" Style="{StaticResource DashLabel}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Grid.Row="1" x:Name="GpuLoadBar" AutomationProperties.Name="GPU 使用率" Style="{StaticResource DashboardBarStyle}" Margin="0,8,0,0" />
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="温度" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="GpuTempText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="功率" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="GpuPowerText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="频率" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="GpuClockText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="电压" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="GpuVoltageText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="显存" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="GpuMemoryText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="显卡风扇" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="GpuFanText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom: system / fans / calendar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="系统" FontSize="13" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock x:Name="MemoryText" DockPanel.Dock="Right" Text="—" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="内存" Style="{StaticResource DashLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar Grid.Row="1" x:Name="MemoryBar" AutomationProperties.Name="内存使用率" Style="{StaticResource DashboardBarStyle}" Height="6" Margin="0,6,0,0" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock x:Name="DiskText" DockPanel.Dock="Right" Text="—" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="系统盘占用" Style="{StaticResource DashLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar Grid.Row="1" x:Name="DiskBar" AutomationProperties.Name="系统盘占用率" Style="{StaticResource DashboardBarStyle}" Height="6" Margin="0,6,0,0" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="网络下行" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="NetDownText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="网络上行" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="NetUpText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="磁盘读取" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="DiskReadText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="磁盘写入" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="DiskWriteText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="系统音量" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="VolumeText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="游戏帧率" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="FpsText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="风扇与温度" FontSize="13" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="冷排风扇（360）" Style="{StaticResource DashLabel}" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FanRadiatorText" Text="—" Style="{StaticResource DashValue}" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="水冷泵" Style="{StaticResource DashLabel}" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FanPumpText" Text="—" Style="{StaticResource DashValue}" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="机箱风扇（前/后）" Style="{StaticResource DashLabel}" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FanCaseText" Text="—" Style="{StaticResource DashValue}" Margin="0,0,0,12" />
                    </Grid>
                    <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="主板温度" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="BoardTempText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="固态温度" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="StorageTempText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CPU 温度" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="CpuTempEchoText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GPU 温度" Style="{StaticResource DashLabel}" />
                            <TextBlock x:Name="GpuTempEchoText" Text="—" Style="{StaticResource DashValue}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="5" Margin="0,14,0,0" FontSize="{DynamicResource TypeCaptionSize}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="接线：CPU_FAN → 360 冷排风扇，PUMP_FAN → 水冷泵，SYS_FAN4 → 机箱前/后风扇；显卡风扇见上方 GPU 卡片。" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="CalendarMonth" DockPanel.Dock="Right" Text="—" FontSize="{DynamicResource TypeCaptionSize}"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="使用日历" FontSize="13" FontWeight="SemiBold" />
                    </DockPanel>
                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,8,0,2">
                        <TextBlock Text="一" FontSize="{DynamicResource TypeCaptionSize}" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock Text="二" FontSize="{DynamicResource TypeCaptionSize}" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock Text="三" FontSize="{DynamicResource TypeCaptionSize}" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock Text="四" FontSize="{DynamicResource TypeCaptionSize}" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock Text="五" FontSize="{DynamicResource TypeCaptionSize}" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock Text="六" FontSize="{DynamicResource TypeCaptionSize}" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock Text="日" FontSize="{DynamicResource TypeCaptionSize}" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                    </UniformGrid>
                    <ItemsControl x:Name="CalendarGrid" Grid.Row="2" VerticalAlignment="Top" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="42" Margin="2" Padding="0"
                                        Style="{StaticResource CalendarDayButtonStyle}"
                                        Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="{Binding BorderThickness}" Tag="{Binding Date}"
                                        IsEnabled="{Binding IsEnabled}" Click="Cell_Click"
                                        AutomationProperties.Name="{Binding Tip}"
                                        AutomationProperties.HelpText="{Binding Date}"
                                        ToolTipService.InitialShowDelay="1000" ToolTip="{Binding Tip}">
                                    <TextBlock Text="{Binding DayText}" FontSize="{DynamicResource TypeCaptionSize}" FontWeight="{Binding FontWeight}"
                                               Foreground="{Binding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <UniformGrid Columns="4" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.2" />
                                <TextBlock Text="&lt;10h" FontSize="{DynamicResource TypeCaptionSize}" Margin="4,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.4" />
                                <TextBlock Text="10-15h" FontSize="{DynamicResource TypeCaptionSize}" Margin="4,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.67" />
                                <TextBlock Text="15-20h" FontSize="{DynamicResource TypeCaptionSize}" Margin="4,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                <TextBlock Text="20-24h" FontSize="{DynamicResource TypeCaptionSize}" Margin="4,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="CalendarTotals" Text="本月合计 —" FontSize="{DynamicResource TypeCaptionSize}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="6" Background="{DynamicResource PanelAltBrush}" CornerRadius="6" Padding="14,10" VerticalAlignment="Bottom">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="系统运行" Style="{StaticResource DashLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="UptimeText" Text="—" FontSize="13" FontWeight="SemiBold"
                           Margin="8,0,24,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="本次开机用电" Style="{StaticResource DashLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" x:Name="SessionEnergyText" Text="—" FontSize="13" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" x:Name="FooterHint" Text="" FontSize="{DynamicResource TypeCaptionSize}"
                           Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
