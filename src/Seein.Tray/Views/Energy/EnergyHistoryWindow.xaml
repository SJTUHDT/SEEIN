<UserControl x:Class="Seein.Tray.EnergyHistoryWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Seein.Tray" xmlns:shared="clr-namespace:Seein.Tray;assembly=Seein.Desktop.Shared"
             Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid x:Name="CalendarView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviousMonthButton" Content="‹ 上月" Click="PreviousMonth_Click" Padding="13,8" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="MonthText" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" HorizontalAlignment="Center" />
                    <TextBlock Text="用电趋势为传感器估算值" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="↻ 刷新" ToolTip="向后台服务重新读取当前页面" Click="Refresh_Click" Padding="11,8" Margin="0,0,8,0" />
                    <Button x:Name="NextMonthButton" Content="下月 ›" Click="NextMonth_Click" Padding="13,8" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,11">
                    <StackPanel><TextBlock Text="本月总耗电" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="MonthTotalText" Text="读取中…" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,11">
                    <StackPanel><TextBlock Text="最高日耗电" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="HighestDayText" Text="无数据" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,11">
                    <StackPanel><TextBlock Text="最低日耗电" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="LowestDayText" Text="无数据" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                </Border>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <UniformGrid Columns="7">
                            <TextBlock Text="一" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="二" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="三" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="四" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="五" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="六" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="日" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                        </UniformGrid>
                        <UniformGrid x:Name="CalendarGrid" Grid.Row="1" Columns="7" Rows="6" />
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <ScrollViewer x:Name="DayView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="‹ 返回日历" Click="CalendarBack_Click" Padding="13,8" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="DayDateText" Style="{StaticResource SectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" HorizontalAlignment="Center" />
                        <TextBlock Text="当日功率及分项均为估算" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="‹ 前一天" Click="PreviousDay_Click" Padding="12,8" Margin="0,0,8,0" />
                        <Button Content="后一天 ›" Click="NextDay_Click" Padding="12,8" Margin="0,0,8,0" />
                        <Button x:Name="RefreshDayButton" Content="↻ 刷新" ToolTip="向后台服务重新读取当天记录" Click="Refresh_Click" Padding="11,8" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"><StackPanel><TextBlock Text="整机合计" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="DayTotalText" Text="读取中…" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"><StackPanel><TextBlock Text="CPU" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="CpuEnergyText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="CpuCoverageText" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" /></StackPanel></Border>
                    <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"><StackPanel><TextBlock Text="GPU" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="GpuEnergyText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="GpuCoverageText" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" /></StackPanel></Border>
                    <Border Grid.Column="6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"><StackPanel><TextBlock Text="其他设备基线" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="OtherEnergyText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                    <Border Grid.Column="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"><StackPanel><TextBlock Text="电源转换损耗" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="LossEnergyText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                </Grid>

                <Border x:Name="LegacyNotice" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <TextBlock x:Name="LegacyText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                </Border>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="210" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="当日整机功率" FontSize="15" FontWeight="SemiBold" />
                        </DockPanel>
                        <local:PowerHistoryChart x:Name="PowerChart" AutomationProperties.Name="当日整机功率曲线" Grid.Row="1" />
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <TextBlock x:Name="CurveHintText" Text="平均功率曲线（仅显示曲线）" FontSize="{DynamicResource TypeCaptionSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,150,0" />
                            <Button x:Name="ChartModeButton" Content="切换到采样条" Click="ToggleChartMode_Click"
                                    Style="{StaticResource ChartModeButtonStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="每日总量长期保留；分钟曲线保留最近 365 天。历史总量无法追溯分项，会列入未分类。" FontSize="{DynamicResource TypeCaptionSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,10,2,4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
