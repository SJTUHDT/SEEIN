<Window x:Class="Seein.Tray.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本更新说明" Width="680" Height="720" MinWidth="500" MinHeight="360"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Seein.Tray;component/Assets/seein.ico" UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource TypeBodySize}">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,22,24,22">
                <TextBlock x:Name="VersionHeading" Style="{StaticResource PageTitleStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="历次版本更新 · 从新到旧" Style="{StaticResource CardCaptionStyle}" Margin="0,8,0,18" />
                <StackPanel x:Name="HistoryEntries" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Padding="24,12" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
            <Button Content="关闭" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="92"
                    Style="{StaticResource AccentButtonStyle}" Click="Close_Click" />
        </Border>
    </Grid>
</Window>
