<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Fluent / Windows 11 dark palette. Key names are unchanged so existing views keep working. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#272727" />
    <SolidColorBrush x:Key="PanelBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#323232" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3745" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#323232" />
    <SolidColorBrush x:Key="HoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1F3745" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ChartBandBrush" Color="#554CC2FF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="GoodBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="WarningFillBrush" Color="#433718" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#10232D" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="InteractionBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFB4A9" />

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="TypeCaptionSize">12</sys:Double>
    <sys:Double x:Key="TypeBodySize">14</sys:Double>
    <sys:Double x:Key="TypeSubtitleSize">20</sys:Double>
    <sys:Double x:Key="TypeTitleSize">28</sys:Double>

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
</ResourceDictionary>
