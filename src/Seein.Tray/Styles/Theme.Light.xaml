<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Fluent / Windows 11 light palette. Key names are unchanged so existing views keep working. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#666666" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F0FA" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E5F0FA" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="ChartBandBrush" Color="#550067C0" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#59000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8A000000" />
    <SolidColorBrush x:Key="GoodBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#7A4E00" />
    <SolidColorBrush x:Key="WarningFillBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#868686" />
    <SolidColorBrush x:Key="InteractionBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="DangerBrush" Color="#A42619" />

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="TypeCaptionSize">12</sys:Double>
    <sys:Double x:Key="TypeBodySize">14</sys:Double>
    <sys:Double x:Key="TypeSubtitleSize">20</sys:Double>
    <sys:Double x:Key="TypeTitleSize">28</sys:Double>

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
</ResourceDictionary>
